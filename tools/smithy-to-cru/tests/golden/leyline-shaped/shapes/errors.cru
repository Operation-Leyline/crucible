structure Field {
    name: string
    message: string
}

list FieldList: Field

error ResourceNotFoundException {
    status 404
    message: string
    resourceId?: string
}

error ThrottlingException {
    status 429
    retryable throttling
    message: string
    @header("Retry-After")
    retryAfter?: integer
}

error ValidationException {
    status 400
    message: string
    fieldList?: FieldList
}
