/// A graph database.
///
/// Organizations hold graphs.
service Leyline {
    version "2026-09-04"
    title "Leyline"
    protocol json
    auth bearer
    paginated(inputToken: nextToken, outputToken: nextToken, pageSize: maxResults)
    operations [GetUsage, Ping]
    resources [Organization]
    errors [ValidationException, ThrottlingException]
}
