{
  "smithy": "2.0",
  "shapes": {
    "example.wait#Jobs": {
      "type": "service",
      "version": "1",
      "traits": {
        "crucible.protocols#json": {}
      },
      "operations": [
        {
          "target": "example.wait#Read"
        }
      ]
    },
    "example.wait#Read": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/read"
        },
        "smithy.api#readonly": {},
        "smithy.waiters#waitable": {
          "Ready": {
            "minDelay": 1,
            "maxDelay": 4,
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "status",
                    "comparator": "stringEquals",
                    "expected": "READY"
                  }
                }
              },
              {
                "state": "failure",
                "matcher": {
                  "output": {
                    "path": "status",
                    "comparator": "stringEquals",
                    "expected": "FAILED"
                  }
                },
                "message": "reasons"
              },
              {
                "state": "retry",
                "matcher": {
                  "errorType": "example.wait#Missing"
                }
              }
            ]
          },
          "AllReady": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "items[].status",
                    "comparator": "allStringEquals",
                    "expected": "READY"
                  }
                }
              }
            ]
          },
          "AnyReady": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "items[].status",
                    "comparator": "anyStringEquals",
                    "expected": "READY"
                  }
                }
              }
            ]
          },
          "FilteredReady": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "length(items[?status == 'READY']) == length(items) && length(items) > `0`",
                    "comparator": "booleanEquals",
                    "expected": "true"
                  }
                }
              }
            ]
          },
          "CountsMatch": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "inputOutput": {
                    "path": "length(input.names) == length(output.items)",
                    "comparator": "booleanEquals",
                    "expected": "true"
                  }
                }
              }
            ]
          },
          "Updated": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "updatedAt > `0`",
                    "comparator": "booleanEquals",
                    "expected": "true"
                  }
                }
              }
            ]
          },
          "Functions": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "(abs(`-2`) == `2`) && (avg(`[1,2]`) == `1.5`) && (ceil(`-1.1`) == `-1`) && (floor(`-1.1`) == `-2`) && (contains(`[true]`, `1`) == `false`) && (ends_with('abc', 'bc')) && (starts_with('abc', 'ab')) && (join(',', `[\"a\",\"b\"]`) == 'a,b') && (keys(`{\"a\":1}`) == `[\"a\"]`) && (values(`{\"a\":1}`) == `[1]`) && (length('😀é') == `2`) && (reverse('😀é') == 'é😀') && (map(&status, items) == `[\"READY\",\"READY\"]`) && (max(`[1,3,2]`) == `3`) && (min(`[1,3,2]`) == `1`) && (max_by(items,&status).status == 'READY') && (min_by(items,&status).status == 'READY') && (sort_by(items,&status)[0].status == 'READY') && (merge(`{\"a\":1}`,`{\"b\":2}`).b == `2`) && (not_null(`null`, 'value') == 'value') && (sort(`[3,1,2]`) == `[1,2,3]`) && (sum(`[1,2,3]`) == `6`) && (to_array('x') == `[\"x\"]`) && (to_number('12345678901234567890.0000000001') > `12345678901234567890`) && (to_string(`true`) == 'true') && (type(`1`) == 'number') && (`[1,2,3]`[::-1] == `[3,2,1]`) && ((`false` || `true`) && !`false`)",
                    "comparator": "booleanEquals",
                    "expected": "true"
                  }
                }
              }
            ]
          },
          "Deleted": {
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "errorType": "example.wait#Missing"
                }
              }
            ]
          }
        }
      },
      "input": {
        "target": "example.wait#Input"
      },
      "output": {
        "target": "example.wait#Output"
      }
    },
    "example.wait#Input": {
      "type": "structure",
      "traits": {
        "smithy.api#input": {}
      },
      "members": {
        "names": {
          "target": "example.wait#Names"
        }
      }
    },
    "example.wait#Output": {
      "type": "structure",
      "members": {
        "status": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#jsonName": "wire-status"
          }
        },
        "items": {
          "target": "example.wait#Items"
        },
        "reasons": {
          "target": "example.wait#Names"
        },
        "updatedAt": {
          "target": "smithy.api#Timestamp"
        }
      }
    },
    "example.wait#Item": {
      "type": "structure",
      "members": {
        "status": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#jsonName": "wire-status"
          }
        }
      }
    },
    "example.wait#Items": {
      "type": "list",
      "member": {
        "target": "example.wait#Item"
      }
    },
    "example.wait#Names": {
      "type": "list",
      "member": {
        "target": "smithy.api#String"
      }
    }
  }
}