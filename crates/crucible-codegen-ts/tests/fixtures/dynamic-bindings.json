          "target": "example.dynamic#Strings",
          "traits": {
            "smithy.api#httpPrefixHeaders": "x-meta-"
          }
        },
        "value": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#jsonName": "wire-value"
          }
        }
      }
    },
