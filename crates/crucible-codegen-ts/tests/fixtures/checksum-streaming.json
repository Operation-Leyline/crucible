{
  "smithy": "2.0",
  "shapes": {
    "example.checksumstream#ChecksumStreaming": {
      "type": "service",
      "version": "1",
      "traits": { "crucible.protocols#json": {} },
      "operations": [
        { "target": "example.checksumstream#Upload" },
        { "target": "example.checksumstream#RequiredUpload" },
        { "target": "example.checksumstream#Download" }
      ]
    },
    "example.checksumstream#Stream": {
      "type": "blob",
      "traits": { "smithy.api#streaming": {} }
    },
    "example.checksumstream#Upload": {
      "type": "operation",
      "input": { "target": "example.checksumstream#UploadInput" },
      "traits": {
        "smithy.api#http": { "method": "PUT", "uri": "/upload", "code": 204 },
        "aws.protocols#httpChecksum": { "requestAlgorithmMember": "algorithm" }
      }
    },
    "example.checksumstream#RequiredUpload": {
      "type": "operation",
      "input": { "target": "example.checksumstream#UploadInput" },
      "traits": {
        "smithy.api#http": { "method": "PUT", "uri": "/required", "code": 204 },
        "aws.protocols#httpChecksum": { "requestChecksumRequired": true, "requestAlgorithmMember": "algorithm" }
      }
    },
    "example.checksumstream#UploadInput": {
      "type": "structure",
      "traits": { "smithy.api#input": {} },
      "members": {
        "body": { "target": "example.checksumstream#Stream", "traits": { "smithy.api#httpPayload": {}, "smithy.api#required": {} } },
        "algorithm": { "target": "example.checksumstream#Algorithm", "traits": { "smithy.api#httpHeader": "x-algorithm" } },
        "checksum": { "target": "smithy.api#String", "traits": { "smithy.api#httpHeader": "x-amz-checksum-sha256" } }
      }
    },
    "example.checksumstream#Download": {
      "type": "operation",
      "input": { "target": "example.checksumstream#DownloadInput" },
      "output": { "target": "example.checksumstream#DownloadOutput" },
      "traits": {
        "smithy.api#http": { "method": "POST", "uri": "/download", "code": 200 },
        "aws.protocols#httpChecksum": { "requestValidationModeMember": "validation", "responseAlgorithms": ["CRC64NVME", "SHA512"] }
      }
    },
    "example.checksumstream#DownloadInput": {
      "type": "structure",
      "traits": { "smithy.api#input": {} },
      "members": {
        "validation": { "target": "example.checksumstream#Validation", "traits": { "smithy.api#httpHeader": "x-validation" } }
      }
    },
    "example.checksumstream#DownloadOutput": {
      "type": "structure",
      "traits": { "smithy.api#output": {} },
      "members": {
        "body": { "target": "example.checksumstream#Stream", "traits": { "smithy.api#httpPayload": {}, "smithy.api#required": {} } }
      }
    },
    "example.checksumstream#Algorithm": {
      "type": "enum",
      "members": {
        "CRC32": { "target": "smithy.api#Unit" },
        "SHA256": { "target": "smithy.api#Unit" }
      }
    },
    "example.checksumstream#Validation": {
      "type": "enum",
      "members": { "ENABLED": { "target": "smithy.api#Unit" } }
    }
  }
}
