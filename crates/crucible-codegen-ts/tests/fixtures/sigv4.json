{
  "smithy": "2.0",
  "shapes": {
    "example.auth#AuthHeader": {
      "type": "service",
      "version": "1",
      "traits": {
        "crucible.protocols#json": {},
        "smithy.api#httpBearerAuth": {},
        "smithy.api#httpBasicAuth": {},
        "smithy.api#httpApiKeyAuth": {
          "name": "x-api-key",
          "in": "header",
          "scheme": "ApiKey"
        },
        "smithy.api#auth": [
          "aws.auth#sigv4"
        ],
        "aws.auth#sigv4": {
          "name": "example"
        },
        "smithy.rules#endpointRuleSet": {
          "version": "1.0",
          "parameters": {
            "Endpoint": {
              "type": "String",
              "builtIn": "SDK::Endpoint",
              "required": true
            }
          },
          "rules": [
            {
              "conditions": [],
              "type": "endpoint",
              "endpoint": {
                "url": "{Endpoint}",
                "headers": {
                  "x-endpoint": [
                    "signed"
                  ]
                },
                "properties": {
                  "authSchemes": [
                    {
                      "name": "sigv4",
                      "signingName": "overridden",
                      "signingRegion": "rule-region",
                      "disableDoubleEncoding": true,
                      "disableNormalizePath": true
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "operations": [
        {
          "target": "example.auth#Mixed"
        },
        {
          "target": "example.auth#Basic"
        },
        {
          "target": "example.auth#Api"
        },
        {
          "target": "example.auth#Public"
        },
        {
          "target": "example.auth#Optional"
        }
      ]
    },
    "example.auth#Mixed": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/mixed",
          "code": 204
        },
        "smithy.api#readonly": {},
        "smithy.api#auth": [
          "aws.auth#sigv4"
        ]
      }
    },
    "example.auth#Basic": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/basic",
          "code": 204
        },
        "smithy.api#readonly": {},
        "smithy.api#auth": [
          "aws.auth#sigv4"
        ]
      }
    },
    "example.auth#Api": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/api",
          "code": 204
        },
        "smithy.api#readonly": {},
        "smithy.api#auth": [
          "aws.auth#sigv4"
        ]
      }
    },
    "example.auth#Public": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/public",
          "code": 204
        },
        "smithy.api#readonly": {},
        "smithy.api#auth": []
      }
    },
    "example.auth#Optional": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/optional",
          "code": 204
        },
        "smithy.api#readonly": {},
        "smithy.api#optionalAuth": {},
        "smithy.api#auth": [
          "aws.auth#sigv4"
        ]
      }
    }
  }
}
