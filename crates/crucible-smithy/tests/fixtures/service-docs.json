          {
            "title": "Write an item",
            "input": {
              "item": {
                "amount": 1234567890123456789
              }
            },
            "output": {
              "state": "READY",
              "at": "2026-01-02T03:04:05Z"
            }
          },
          {
            "title": "Service unavailable",
            "input": {
              "item": {
                "text": "retry"
              }
            },
            "error": {
