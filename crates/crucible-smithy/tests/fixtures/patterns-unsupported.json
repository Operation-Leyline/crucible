{
  "smithy": "2.0",
  "shapes": {
    "example.patterns#Patterns": {"type": "service", "version": "1", "traits": {"crucible.protocols#json": {}}, "operations": [{"target": "example.patterns#Check"}]},
    "example.patterns#Check": {"type": "operation", "traits": {"smithy.api#http": {"method": "POST", "uri": "/check", "code": 200}}, "input": {"target": "example.patterns#Input"}},
    "example.patterns#Input": {"type": "structure", "members": {
      "flags": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "(?i)abc"}},
      "anchor": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "\\Aabc"}},
      "property": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "\\p{Letter}"}},
      "surrogate": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "\\uD800"}},
      "lookahead": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "(?=abc)"}},
      "backreference": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "(abc)\\1"}},
      "wordstart": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "\\<abc"}},
      "wordend": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "abc\\>"}}
    }}
  }
}
