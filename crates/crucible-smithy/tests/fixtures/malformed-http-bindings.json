{
  "smithy": "2.0",
  "shapes": {
    "test.bindings#Service": {
      "type": "service",
      "version": "1",
      "traits": {
        "crucible.protocols#json": {}
      },
      "operations": [
        {
          "target": "test.bindings#Duplicates"
        },
        {
          "target": "test.bindings#MissingMethod"
        },
        {
          "target": "test.bindings#BadCode"
        },
        {
          "target": "test.bindings#EmptySegment"
        },
        {
          "target": "test.bindings#QueryLabel"
        },
        {
          "target": "test.bindings#NoSlash"
        },
        {
          "target": "test.bindings#RouteA"
        },
        {
          "target": "test.bindings#RouteB"
        }
      ]
    },
    "test.bindings#Duplicates": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/a/{x}/{x}?q=1"
        }
      },
      "input": {
        "target": "test.bindings#DuplicatesInput"
      }
    },
    "test.bindings#DuplicatesInput": {
      "type": "structure",
      "members": {
        "x": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpLabel": {},
            "smithy.api#required": {}
          }
        },
        "httpQuery0": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpQuery": "q"
          }
        },
        "httpQuery1": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpQuery": "q"
          }
        },
        "httpHeader0": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpHeader": "X-A"
          }
        },
        "httpHeader1": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpHeader": "x-a"
          }
        }
      }
    },
    "test.bindings#MissingMethod": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "uri": "/missing"
        }
      }
    },
    "test.bindings#BadCode": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/code",
          "code": 70000
        }
      }
    },
    "test.bindings#EmptySegment": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/a//b"
        }
      }
    },
    "test.bindings#QueryLabel": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/query?x={y}"
        }
      }
    },
    "test.bindings#NoSlash": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "a/b"
        }
      }
    },
    "test.bindings#RouteA": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/route/{x}"
        }
      },
      "input": {
        "target": "test.bindings#RouteAInput"
      }
    },
    "test.bindings#RouteAInput": {
      "type": "structure",
      "members": {
        "x": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpLabel": {},
            "smithy.api#required": {}
          }
        }
      }
    },
    "test.bindings#RouteB": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/route/{y}"
        }
      },
      "input": {
        "target": "test.bindings#RouteBInput"
      }
    },
    "test.bindings#RouteBInput": {
      "type": "structure",
      "members": {
        "y": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpLabel": {},
            "smithy.api#required": {}
          }
        }
      }
    }
  }
}
