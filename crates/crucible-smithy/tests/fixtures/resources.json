{
  "smithy": "2.0",
  "shapes": {
    "example.resources#Service": {
      "type": "service", "version": "1",
      "resources": [{"target": "example.resources#Inbox"}],
      "traits": {"crucible.protocols#json": {}}
    },
    "example.resources#Inbox": {
      "type": "resource",
      "identifiers": {"inboxId": {"target": "example.resources#InboxId"}},
      "properties": {"name": {"target": "smithy.api#String"}},
      "create": {"target": "example.resources#Allocate"},
      "read": {"target": "example.resources#Inspect"},
      "update": {"target": "example.resources#Change"},
      "delete": {"target": "example.resources#Remove"},
      "resources": [{"target": "example.resources#Message"}],
      "traits": {"smithy.api#documentation": "A mailbox.", "example.resources#deployment": {"kind": "mailbox"}}
    },
    "example.resources#Message": {
      "type": "resource",
      "identifiers": {"inboxId": {"target": "example.resources#InboxId"}, "messageId": {"target": "smithy.api#String"}},
      "properties": {"body": {"target": "example.resources#Body"}},
      "put": {"target": "example.resources#Store"},
      "list": {"target": "example.resources#Scan"},
      "operations": [{"target": "example.resources#InspectMessage"}],
      "collectionOperations": [{"target": "example.resources#Purge"}],
      "traits": {"smithy.api#noReplace": {}}
    },
    "example.resources#InboxId": {"type": "string", "traits": {"smithy.api#references": [{"resource": "example.resources#Inbox"}]}},
    "example.resources#Body": {"type": "string"},
    "example.resources#Allocate": {"type": "operation", "input": {"target": "example.resources#WriteInput"}, "output": {"target": "example.resources#ReadOutput"}, "traits": {"smithy.api#http": {"method": "POST", "uri": "/inbox"}}},
    "example.resources#Inspect": {"type": "operation", "input": {"target": "example.resources#ReadInput"}, "output": {"target": "example.resources#ReadOutput"}, "traits": {"smithy.api#http": {"method": "GET", "uri": "/inbox"}, "smithy.api#readonly": {}}},
    "example.resources#Change": {"type": "operation", "input": {"target": "example.resources#WriteInput"}, "traits": {"smithy.api#http": {"method": "PATCH", "uri": "/inbox"}}},
    "example.resources#Remove": {"type": "operation", "input": {"target": "example.resources#ReadInput"}, "traits": {"smithy.api#http": {"method": "DELETE", "uri": "/inbox"}}},
    "example.resources#Store": {"type": "operation", "traits": {"smithy.api#http": {"method": "PUT", "uri": "/message"}, "smithy.api#idempotent": {}}},
    "example.resources#Scan": {"type": "operation", "traits": {"smithy.api#http": {"method": "GET", "uri": "/messages"}, "smithy.api#readonly": {}}},
    "example.resources#InspectMessage": {"type": "operation", "traits": {"smithy.api#http": {"method": "GET", "uri": "/message"}}},
    "example.resources#Purge": {"type": "operation", "traits": {"smithy.api#http": {"method": "POST", "uri": "/messages/purge"}}},
    "example.resources#ReadInput": {
      "type": "structure",
      "members": {
        "inboxId": {"target": "example.resources#InboxId", "traits": {"smithy.api#required": {}}},
        "id": {"target": "example.resources#InboxId", "traits": {"smithy.api#required": {}, "smithy.api#resourceIdentifier": "inboxId"}}
      }
    },
    "example.resources#WriteInput": {
      "type": "structure",
      "members": {
        "displayName": {"target": "smithy.api#String", "traits": {"smithy.api#property": {"name": "name"}}},
        "clientToken": {"target": "smithy.api#String", "traits": {"smithy.api#idempotencyToken": {}}},
        "external": {"target": "example.resources#ExternalReference"}
      }
    },
    "example.resources#ReadOutput": {
      "type": "structure",
      "members": {
        "inbox": {"target": "example.resources#InboxData", "traits": {"smithy.api#nestedProperties": {}}}
      }
    },
    "example.resources#InboxData": {
      "type": "structure",
      "traits": {"smithy.api#references": [{"resource": "example.resources#Inbox", "ids": {"inboxId": "id"}}]},
      "members": {
        "id": {"target": "example.resources#InboxId"},
        "name": {"target": "smithy.api#String"}
      }
    },
    "example.resources#ExternalReference": {
      "type": "structure",
      "traits": {"smithy.api#references": [{"resource": "external.service#Account", "service": "external.service#Service", "ids": {"accountId": "id"}, "rel": "owner"}]},
      "members": {"id": {"target": "smithy.api#String"}}
    }
  }
}
