{
  "smithy": "2.0",
  "shapes": {
    "example.vault#Vault": {
      "type": "service",
      "version": "2026-10-05",
      "traits": {
        "smithy.protocols#rpcv2Cbor": {},
        "smithy.api#httpDigestAuth": {},
        "aws.auth#sigv4a": {
          "name": "vault"
        },
        "smithy.api#auth": [
          "smithy.api#httpDigestAuth",
          "aws.auth#sigv4a"
        ]
      },
      "operations": [
        {
          "target": "example.vault#Put"
        },
        {
          "target": "example.vault#Sign"
        },
        {
          "target": "example.vault#Ping"
        }
      ],
      "errors": [
        {
          "target": "example.vault#Denied"
        }
      ]
    },
    "example.vault#Put": {
      "type": "operation",
      "input": {
        "target": "example.vault#Record"
      },
      "output": {
        "target": "example.vault#Record"
      },
      "traits": {
        "smithy.api#auth": [
          "smithy.api#httpDigestAuth"
        ],
        "smithy.api#idempotent": {}
      }
    },
    "example.vault#Sign": {
      "type": "operation",
      "input": {
        "target": "example.vault#SignInput"
      },
      "output": {
        "target": "example.vault#SignOutput"
      },
      "traits": {
        "smithy.api#auth": [
          "aws.auth#sigv4a"
        ]
      }
    },
    "example.vault#Ping": {
      "type": "operation",
      "traits": {
        "smithy.api#auth": [],
        "smithy.api#readonly": {}
      }
    },
    "example.vault#Record": {
      "type": "structure",
      "members": {
        "key": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {}
          }
        },
        "data": {
          "target": "smithy.api#Blob"
        },
        "when": {
          "target": "smithy.api#Timestamp"
        },
        "count": {
          "target": "smithy.api#BigInteger"
        },
        "ratio": {
          "target": "smithy.api#BigDecimal"
        },
        "small": {
          "target": "smithy.api#Long"
        },
        "score": {
          "target": "smithy.api#Double"
        },
        "level": {
          "target": "smithy.api#Float"
        },
        "tags": {
          "target": "example.vault#Tags"
        },
        "items": {
          "target": "example.vault#Items"
        },
        "choice": {
          "target": "example.vault#Choice"
        }
      }
    },
    "example.vault#Tags": {
      "type": "map",
      "key": {
        "target": "smithy.api#String"
      },
      "value": {
        "target": "smithy.api#String"
      }
    },
    "example.vault#Items": {
      "type": "list",
      "member": {
        "target": "smithy.api#Blob"
      }
    },
    "example.vault#Choice": {
      "type": "union",
      "members": {
        "text": {
          "target": "smithy.api#String"
        },
        "bytes": {
          "target": "smithy.api#Blob"
        }
      }
    },
    "example.vault#SignInput": {
      "type": "structure",
      "members": {
        "value": {
          "target": "smithy.api#String"
        }
      }
    },
    "example.vault#SignOutput": {
      "type": "structure",
      "members": {
        "regionSet": {
          "target": "smithy.api#String"
        },
        "value": {
          "target": "smithy.api#String"
        }
      }
    },
    "example.vault#Denied": {
      "type": "structure",
      "traits": {
        "smithy.api#error": "client",
        "smithy.api#httpError": 403
      },
      "members": {
        "message": {
          "target": "smithy.api#String"
        },
        "reason": {
          "target": "smithy.api#String"
        }
      }
    }
  }
}
