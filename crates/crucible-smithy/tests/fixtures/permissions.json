{
  "smithy": "2.0",
  "shapes": {
    "example.leyline#Leyline": {
      "type": "service", "version": "2026-10-01",
      "traits": {"crucible.protocols#json": {}, "smithy.api#httpBearerAuth": {}},
      "operations": [{"target": "example.leyline#GetUser"}],
      "resources": [{"target": "example.leyline#Organization"}]
    },
    "crucible.protocols#json": {"type": "structure", "traits": {"smithy.api#trait": {}, "smithy.api#protocolDefinition": {}}},

    "example.leyline#OrganizationId": {"type": "string", "traits": {"smithy.api#pattern": "^org_[a-z0-9]+$"}},
    "example.leyline#GraphId": {"type": "string", "traits": {"smithy.api#pattern": "^g_[a-z0-9]+$"}},
    "example.leyline#HistoryId": {"type": "string", "traits": {"smithy.api#pattern": "^h_[a-z0-9]+$"}},

    "example.leyline#Organization": {
      "type": "resource",
      "identifiers": {"organizationId": {"target": "example.leyline#OrganizationId"}},
      "read": {"target": "example.leyline#GetOrganization"},
      "resources": [{"target": "example.leyline#Graph"}],
      "traits": {"crucible.auth#authorizationName": "org"}
    },
    "example.leyline#Graph": {
      "type": "resource",
      "identifiers": {
        "organizationId": {"target": "example.leyline#OrganizationId"},
        "graphId": {"target": "example.leyline#GraphId"}
      },
      "create": {"target": "example.leyline#CreateGraph"},
      "read": {"target": "example.leyline#GetGraph"},
      "list": {"target": "example.leyline#ListGraphs"},
      "operations": [{"target": "example.leyline#ExecuteQuery"}],
      "resources": [{"target": "example.leyline#History"}]
    },
    "example.leyline#History": {
      "type": "resource",
      "identifiers": {
        "organizationId": {"target": "example.leyline#OrganizationId"},
        "graphId": {"target": "example.leyline#GraphId"},
        "historyId": {"target": "example.leyline#HistoryId"}
      },
      "operations": [{"target": "example.leyline#RestoreBackup"}]
    },

    "example.leyline#OrganizationPermission": {
      "type": "enum",
      "traits": {"crucible.auth#permissionsOf": "example.leyline#Organization"},
      "members": {
        "READ": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "organization:read", "smithy.api#internal": {}}},
        "ADMIN": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "organization:admin", "crucible.auth#notGrantable": {},
          "smithy.api#documentation": "Everything in the organization."}}
      }
    },
    "example.leyline#GraphPermission": {
      "type": "enum",
      "traits": {"crucible.auth#permissionsOf": "example.leyline#Graph"},
      "members": {
        "READ": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "graph:read", "smithy.api#documentation": "Read a graph and its catalog."}},
        "WRITE": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "graph:write"}},
        "AUDIT": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "graph:audit", "crucible.auth#permissionOnly": {}}},
        "VIEW": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "graph:view", "crucible.auth#aliasOf": "READ",
          "smithy.api#deprecated": {"message": "Renamed to graph:read."}}}
      }
    },
    "example.leyline#HistoryPermission": {
      "type": "enum",
      "traits": {"crucible.auth#permissionsOf": "example.leyline#History"},
      "members": {
        "READ": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "history:read"}},
        "RESTORE": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "history:restore", "crucible.auth#permissionOnly": {}}}
      }
    },
    "example.leyline#ResourceKind": {
      "type": "enum",
      "traits": {"crucible.auth#permissionTypes": {"exclude": ["example.leyline#History"]}},
      "members": {
        "ORG": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "org"}},
        "GRAPH": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "graph"}}
      }
    },

    "example.leyline#GetUser": {
      "type": "operation",
      "output": {"target": "example.leyline#GetUserOutput"},
      "traits": {"smithy.api#http": {"method": "GET", "uri": "/user", "code": 200}, "smithy.api#readonly": {},
        "crucible.auth#requiresNone": "Answers about the caller's own credential."}
    },
    "example.leyline#GetUserOutput": {"type": "structure", "members": {"subject": {"target": "smithy.api#String", "traits": {"smithy.api#required": {}}}}},

    "example.leyline#GetOrganization": {
      "type": "operation",
      "input": {"target": "example.leyline#GetOrganizationInput"},
      "traits": {"smithy.api#http": {"method": "GET", "uri": "/orgs/{organizationId}", "code": 200}, "smithy.api#readonly": {},
        "crucible.auth#requires": [{"permission": "organization:read", "resource": "example.leyline#Organization"}]}
    },
    "example.leyline#GetOrganizationInput": {"type": "structure", "members": {
      "organizationId": {"target": "example.leyline#OrganizationId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}}
    }},

    "example.leyline#CreateGraph": {
      "type": "operation",
      "input": {"target": "example.leyline#CreateGraphInput"},
      "traits": {"smithy.api#http": {"method": "POST", "uri": "/orgs/{organizationId}/graphs", "code": 201},
        "crucible.auth#requires": [{"permission": "graph:write", "resource": "example.leyline#Graph", "bind": {"graphId": "*"}}]}
    },
    "example.leyline#CreateGraphInput": {"type": "structure", "members": {
      "organizationId": {"target": "example.leyline#OrganizationId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}},
      "name": {"target": "smithy.api#String", "traits": {"smithy.api#required": {}}}
    }},

    "example.leyline#GetGraph": {
      "type": "operation",
      "input": {"target": "example.leyline#GetGraphInput"},
      "traits": {"smithy.api#http": {"method": "GET", "uri": "/orgs/{organizationId}/graphs/{graph}", "code": 200}, "smithy.api#readonly": {},
        "crucible.auth#requires": [{"permission": "graph:read", "resource": "example.leyline#Graph", "bind": {"graphId": "$graph"}}]}
    },
    "example.leyline#GetGraphInput": {"type": "structure", "members": {
      "organizationId": {"target": "example.leyline#OrganizationId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}},
      "graph": {"target": "example.leyline#GraphId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}}
    }},

    "example.leyline#ListGraphs": {
      "type": "operation",
      "input": {"target": "example.leyline#ListGraphsInput"},
      "traits": {"smithy.api#http": {"method": "GET", "uri": "/orgs/{org}/graphs", "code": 200}, "smithy.api#readonly": {},
        "crucible.auth#requires": [{"permission": "graph:read", "resource": "example.leyline#Graph", "mode": "filter",
          "documentation": "Returns only the graphs the caller may read."}]}
    },
    "example.leyline#ListGraphsInput": {"type": "structure", "members": {
      "org": {"target": "example.leyline#OrganizationId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}, "smithy.api#resourceIdentifier": "organizationId"}}
    }},

    "example.leyline#ExecuteQuery": {
      "type": "operation",
      "input": {"target": "example.leyline#ExecuteQueryInput"},
      "traits": {"smithy.api#http": {"method": "POST", "uri": "/orgs/{organizationId}/graphs/{graphId}/query", "code": 200},
        "crucible.auth#requires": [
          {"permission": "graph:read", "resource": "example.leyline#Graph"},
          {"permission": "graph:write", "resource": "example.leyline#Graph", "mode": "handler", "documentation": "Only when the parsed query writes."},
          {"permission": "history:read", "resource": "example.leyline#History",
            "bind": {"historyId": "target.history.historyId"}, "when": "has target.history"}
        ]}
    },
    "example.leyline#ExecuteQueryInput": {"type": "structure", "members": {
      "organizationId": {"target": "example.leyline#OrganizationId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}},
      "graphId": {"target": "example.leyline#GraphId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}},
      "query": {"target": "smithy.api#String", "traits": {"smithy.api#required": {}}},
      "target": {"target": "example.leyline#QueryTarget"}
    }},
    "example.leyline#QueryTarget": {"type": "union", "members": {
      "current": {"target": "smithy.api#Unit"},
      "history": {"target": "example.leyline#HistoryRef"}
    }},
    "example.leyline#HistoryRef": {"type": "structure", "members": {
      "historyId": {"target": "example.leyline#HistoryId", "traits": {"smithy.api#required": {}}}
    }},

    "example.leyline#RestoreBackup": {
      "type": "operation",
      "input": {"target": "example.leyline#RestoreBackupInput"},
      "traits": {"smithy.api#http": {"method": "POST", "uri": "/orgs/{organizationId}/graphs/{graphId}/histories/{historyId}/restore", "code": 200},
        "crucible.auth#requiresPending": "guard::allow in the handler until the history module moves."}
    },
    "example.leyline#RestoreBackupInput": {"type": "structure", "members": {
      "organizationId": {"target": "example.leyline#OrganizationId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}},
      "graphId": {"target": "example.leyline#GraphId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}},
      "historyId": {"target": "example.leyline#HistoryId", "traits": {"smithy.api#required": {}, "smithy.api#httpLabel": {}}}
    }},

    "crucible.errors#NotFoundException": {
      "type": "structure",
      "members": {
        "message": {"target": "smithy.api#String", "traits": {"smithy.api#required": {}}},
        "resourceType": {"target": "smithy.api#String", "traits": {"smithy.api#required": {}}}
      },
      "traits": {"smithy.api#error": "client", "smithy.api#httpError": 404,
        "smithy.api#documentation": "The resource does not exist, or the caller may not know that it does."}
    }
  }
}
