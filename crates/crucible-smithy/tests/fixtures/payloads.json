{
  "smithy": "2.0",
  "shapes": {
    "example.wire#Wire": {
      "type": "service",
      "version": "1",
      "traits": {
        "crucible.protocols#json": {}
      },
      "operations": [
        {
          "target": "example.wire#Text"
        },
        {
          "target": "example.wire#Document"
        }
      ]
    },
    "example.wire#TextInput": {
      "type": "structure",
      "members": {
        "text": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpPayload": {}
          }
        },
        "meta": {
          "target": "example.wire#MediaList",
          "traits": {
            "smithy.api#httpHeader": "x-meta"
          }
        }
      }
    },
    "example.wire#Text": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/text",
          "code": 200
        }
      },
      "input": {
        "target": "example.wire#TextInput"
      },
      "output": {
        "target": "example.wire#TextOutput"
      }
    },
    "example.wire#Media": {
      "type": "string",
      "traits": {
        "smithy.api#mediaType": "application/json"
      }
    },
    "example.wire#MediaList": {
      "type": "list",
      "member": {
        "target": "example.wire#Media"
      }
    },
    "example.wire#Record": {
      "type": "structure",
      "members": {
        "name": {
          "target": "smithy.api#String"
        }
      }
    },
    "example.wire#DocumentInput": {
      "type": "structure",
      "members": {
        "document": {
          "target": "example.wire#Record",
          "traits": {
            "smithy.api#httpPayload": {}
          }
        }
      }
    },
    "example.wire#Document": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/document",
          "code": 200
        }
      },
      "input": {
        "target": "example.wire#DocumentInput"
      },
      "output": {
        "target": "example.wire#DocumentOutput"
      }
    },
    "example.wire#TextOutput": {
      "type": "structure",
      "members": {
        "text": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpPayload": {}
          }
        },
        "meta": {
          "target": "example.wire#MediaList",
          "traits": {
            "smithy.api#httpHeader": "x-meta"
          }
        }
      }
    },
    "example.wire#DocumentOutput": {
      "type": "structure",
      "members": {
        "document": {
          "target": "example.wire#Record",
          "traits": {
            "smithy.api#httpPayload": {}
          }
        }
      }
    }
  }
}
