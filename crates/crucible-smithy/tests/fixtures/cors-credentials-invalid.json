{
  "smithy": "2.0",
  "shapes": {
    "example.cors#CorsService": {
      "type": "service",
      "version": "1",
      "operations": [
        {
          "target": "example.cors#Read"
        }
      ],
      "traits": {
        "crucible.protocols#json": {},
        "smithy.api#httpBearerAuth": {},
        "smithy.api#cors": {
          "additionalAllowedHeaders": [
            "X-Extra",
            "x-input"
          ],
          "additionalExposedHeaders": [
            "X-Extra-Response",
            "X-Output"
          ]
        },
        "smithy.api#httpBasicAuth": {}
      }
    },
    "example.cors#Read": {
      "type": "operation",
      "input": {
        "target": "example.cors#ReadInput"
      },
      "output": {
        "target": "example.cors#ReadOutput"
      },
      "errors": [
        {
          "target": "example.cors#CorsError"
        }
      ],
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/cors/{id}"
        }
      }
    },
    "example.cors#ReadInput": {
      "type": "structure",
      "traits": {
        "smithy.api#input": {}
      },
      "members": {
        "id": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {},
            "smithy.api#httpLabel": {}
          }
        },
        "header": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpHeader": "X-Input"
          }
        },
        "metadata": {
          "target": "example.cors#Headers",
          "traits": {
            "smithy.api#httpPrefixHeaders": "X-Meta-"
          }
        }
      }
    },
    "example.cors#ReadOutput": {
      "type": "structure",
      "traits": {
        "smithy.api#output": {}
      },
      "members": {
        "header": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpHeader": "X-Output"
          }
        }
      }
    },
    "example.cors#Headers": {
      "type": "map",
      "key": {
        "target": "smithy.api#String"
      },
      "value": {
        "target": "smithy.api#String"
      }
    },
    "example.cors#CorsError": {
      "type": "structure",
      "traits": {
        "smithy.api#error": "client",
        "smithy.api#httpError": 409
      },
      "members": {
        "message": {
          "target": "smithy.api#String"
        },
        "header": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#httpHeader": "X-Error"
          }
        }
      }
    }
  }
}
