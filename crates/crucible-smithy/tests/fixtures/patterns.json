{
  "smithy": "2.0",
  "shapes": {
    "example.patterns#Patterns": {"type": "service", "version": "1", "traits": {"crucible.protocols#json": {}}, "operations": [{"target": "example.patterns#Check"}]},
    "example.patterns#Check": {"type": "operation", "traits": {"smithy.api#http": {"method": "POST", "uri": "/check", "code": 200}}, "input": {"target": "example.patterns#Input"}},
    "example.patterns#Input": {"type": "structure", "members": {
      "digits": {"target": "example.patterns#Digits"},
      "word": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "^\\w+$"}},
      "dot": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "^a.b$"}},
      "space": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "^\\s$"}},
      "boundary": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "\\ba\\b"}},
      "class": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "^[\\D\\W\\S\\b.]+$"}},
      "literal": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "^\\\\d\\.\\u00e9\\x41\\cA$"}},
      "operators": {"target": "smithy.api#String", "traits": {"smithy.api#pattern": "^[a&&b~~c]$"}}
    }},
    "example.patterns#Digits": {"type": "string", "traits": {"smithy.api#pattern": "^\\d+$"}}
  }
}
