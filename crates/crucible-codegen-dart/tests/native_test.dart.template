@TestOn('vm')
library;
import 'dart:typed_data';
import 'package:test/test.dart';
import 'package:weather_client/weather_client.dart';
import 'fixtures.dart';

void main() {
  test('real weather HTTP, typed errors, pagination and binary payloads', () async {
    final sdk = WeatherClient(ClientConfig(endpoint:weatherUrl, token:() => 'test-token'));
    addTearDown(sdk.close);
    await sdk.ping();
    const input = CreateCityInput(name:'dart-http', location:LocationUnknown(Unit()));
    final city = (await sdk.createCity(input)).city;
    final fetched = await sdk.getCity(GetCityInput(cityId:city.id));
    expect(fetched.city.name, 'dart-http'); expect(fetched.requestId, isNotNull);
    final bytes = Uint8List.fromList([0,1,255,128,13,10,65,66,67]);
    final stored = await sdk.putCityPhoto(PutCityPhotoInput(cityId:city.id, caption:'binary', photo:bytes));
    expect(stored.photo.size, 9); expect(stored.photo.thumbnail, bytes.sublist(0,8));
    final photo = await sdk.getCityPhoto(GetCityPhotoInput(cityId:city.id));
    expect(photo.photo, bytes); expect(photo.caption, 'binary');
    await expectLater(sdk.createCity(input), throwsA(isA<ConflictError>()));
    var found = false;
    await for (final page in sdk.listCitiesPages(const ListCitiesInput(maxResults:1))) {
      found = found || page.cities.any((item) => item.id == city.id);
    }
    expect(found, isTrue);
  });
}
