import 'dart:convert';
import 'dart:typed_data';
import 'package:test/test.dart';
import 'package:dynamic_client/dynamic_client.dart';

final class Fake implements HttpTransport {
  final HttpResponse response;
  Fake(this.response);
  @override
  Future<HttpResponse> send(HttpRequest request, {required bool readBody, required CancellationToken cancellation}) async {
    expect(request.method, 'POST');
    expect(request.url.toString(), 'http://127.0.0.1/files/folder/a%20b?empty=&tag=hello%20world&tag=%2F');
    expect(request.headers['x-meta-trace'], 'abc');
    expect(jsonDecode(utf8.decode(request.body!)), {'wire-value': 'hello'});
    return response;
  }
  @override
  void close() {}
}
void main() {
  final input = Input(key: 'folder/a b', query: {'tag': ['hello world', '/'], 'empty': ['']}, metadataValue: {'trace': 'abc'}, value: 'hello');
  test('dynamic request and response bindings', () async {
    final sdk = DynamicClient(ClientConfig(endpoint: 'http://127.0.0.1', transport: Fake(HttpResponse(status: 206, headers: {'X-Meta-Trace': 'abc'}, body: Uint8List.fromList(utf8.encode('{"wire-value":"result","value":"ignored"}'))))));
    final output = await sdk.getValue(input);
    expect(output.status, 206);
    expect(output.metadataValue, {'trace': 'abc'});
    expect(output.value, 'result');
  });
  test('modeled error prefix headers and status', () async {
    final sdk = DynamicClient(ClientConfig(endpoint: 'http://127.0.0.1', transport: Fake(HttpResponse(status: 422, headers: {'x-crucible-error': 'Problem', 'x-meta-reason': 'invalid'}, body: Uint8List.fromList(utf8.encode('{}'))))));
    try { await sdk.getValue(input); fail('Expected Problem'); }
    on Problem catch (error) { expect(error.status, 422); expect(error.details, {'reason': 'invalid'}); }
  });
  test('greedy dot segments rejected', () async {
    final sdk = DynamicClient(ClientConfig(endpoint: 'http://127.0.0.1', transport: Fake(HttpResponse(status: 200))));
    for (final key in ['a/../b', './a', 'a/.']) await expectLater(sdk.getValue(Input(key: key)), throwsFormatException);
  });
}
