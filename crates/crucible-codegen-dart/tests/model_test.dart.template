import 'models.dart';
import 'schema.dart';
import 'runtime/codec.dart';
import 'runtime/json.dart';
import 'runtime/timestamp.dart';
import 'runtime/errors.dart';

void check(bool value, String message) { if (!value) throw StateError(message); }
void main() {
  final schema = wireObject(exactJsonDecode(schemaSource));
  final codec = WireCodec(schema, decodeModel);
  final shapes = wireObject(schema['shapes']);
  String id(String name) => shapes.keys.singleWhere((id) => wireObject(shapes[id])['name'] == name);
  final population = BigInt.parse('9223372036854775807');
  final city = CitySummary(id:'x', name:'name', population:population,
    updatedAt:Timestamp.parse('2026-10-04T00:00:00.123456789Z'));
  final context = codec.context(id('CitySummary'));
  final encoded = codec.encode(city, context);
  final copy = codec.decode(exactJsonDecode(exactJsonEncode(encoded)), context) as CitySummary;
  check(copy.population == population, 'Generated long round trip');
  check(copy.updatedAt == city.updatedAt, 'Generated timestamp round trip');
  final union = codec.context(id('Location'));
  for (final value in <Location>[const LocationUnknown(Unit()), const LocationCoordinates(null), LocationUnknownVariant('future', JsonValue.parse('9223372036854775807'))]) {
    final encoded = codec.encode(value, union);
    final decoded = codec.decode(encoded, union);
    check(decoded.runtimeType == value.runtimeType, 'Union variant class');
    check(exactJsonEncode(codec.encode(decoded, union)) == exactJsonEncode(encoded), 'Union round trip');
  }
  final forecast = codec.context(id('Forecast'));
  final value = <Sky, JsonValue>{const Sky('future'): JsonValue.parse('[9223372036854775807]')};
  final decoded = codec.decode(codec.encode(value, forecast), forecast) as Forecast;
  check(decoded[const Sky('future')]!.encode() == '[9223372036854775807]', 'Open enum map key');
  final errorId = id('ConflictError');
  final error = decodeError(errorId, {'message':'conflict'}, codec.context(errorId), const ErrorMetadata(name:'ConflictError', status:409));
  check(error is WeatherException && error is ConflictError && error.message == 'conflict' && error.metadata.status == 409, 'Typed error');
  print('Generated model qualification passed');
}
