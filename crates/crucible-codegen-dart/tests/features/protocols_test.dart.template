import 'dart:async';
import 'dart:convert';
import 'dart:typed_data';
import 'package:test/test.dart';
import 'package:restjson_client/restjson_client.dart' as rest;
import 'package:json10_client/json10_client.dart' as json10;
import 'package:json11_client/json11_client.dart' as json11;

final class Fake<Request, Response> {
  final requests = <Request>[];
}

final class RestFake extends Fake<rest.HttpRequest, rest.HttpResponse> implements rest.HttpTransport {
  final rest.HttpResponse Function(rest.HttpRequest) handler;
  RestFake(this.handler);
  @override
  Future<rest.HttpResponse> send(rest.HttpRequest request, {required bool readBody, required rest.CancellationToken cancellation}) async {
    requests.add(request);
    return handler(request);
  }

  @override
  void close() {}
}

final class Json10Fake extends Fake<json10.HttpRequest, json10.HttpResponse> implements json10.HttpTransport {
  final json10.HttpResponse Function(json10.HttpRequest) handler;
  Json10Fake(this.handler);
  @override
  Future<json10.HttpResponse> send(json10.HttpRequest request, {required bool readBody, required json10.CancellationToken cancellation}) async {
    requests.add(request);
    return handler(request);
  }

  @override
  void close() {}
}

final class Json11Fake extends Fake<json11.HttpRequest, json11.HttpResponse> implements json11.HttpTransport {
  final json11.HttpResponse Function(json11.HttpRequest) handler;
  Json11Fake(this.handler);
  @override
  Future<json11.HttpResponse> send(json11.HttpRequest request, {required bool readBody, required json11.CancellationToken cancellation}) async {
    requests.add(request);
    return handler(request);
  }

  @override
  void close() {}
}

Uint8List bytes(Object value) => Uint8List.fromList(utf8.encode(jsonEncode(value)));

/// Checks one request as the protocol's wire contract describes it, then echoes it.
Map<String, Object?> checkEcho(String method, Uri url, Map<String, String> headers, Uint8List? body, String? version) {
  expect(method, 'POST');
  final values = jsonDecode(utf8.decode(body!)) as Map<String, Object?>;
  expect(values['when'], -0.25);
  expect(rest.Timestamp.parse(values['iso'] as String), rest.Timestamp(BigInt.from(-1), 750000000));
  expect(values.containsKey('nullable'), isFalse);
  expect(values.containsKey('document'), isTrue);
  expect(values['document'], isNull);
  expect(values['floatValue'], 'NaN');
  expect(values['doubleValue'], 'Infinity');
  expect(values[version == null ? 'wire-name' : 'renamed'], 'hello');
  if (version != null) {
    expect(url.path, '/');
    expect(headers['x-amz-target'], 'JsonService.Echo');
    expect(headers['content-type'], 'application/x-amz-json-$version');
    expect(values['date'], -0.25);
    expect(values['dates'], [-0.25]);
  } else {
    expect(url.path, '/echo');
    expect(headers['content-type'], 'application/json');
    expect(rest.Timestamp.parse(url.queryParameters['time']!), rest.Timestamp(BigInt.from(-1), 750000000));
    expect(headers['x-date'], 'Wed, 31 Dec 1969 23:59:59 GMT');
    expect(headers['x-dates'], 'Wed, 31 Dec 1969 23:59:59 GMT');
    expect(values.containsKey('date'), isFalse);
  }
  return {...values, 'choice': {'text': 'ok', '__type': 'ignored'}, 'nullable': null};
}

void main() {
  final instant = rest.Timestamp(BigInt.from(-1), 750000000);

  test('restJson1 bindings, null omission, unions and non-finite floats', () async {
    final fake = RestFake((request) => rest.HttpResponse(status: 200,
        headers: {'x-date': 'Wed, 31 Dec 1969 23:59:59 GMT', 'x-dates': 'Wed, 31 Dec 1969 23:59:59 GMT, Thu, 01 Jan 1970 00:00:01 GMT'},
        body: bytes(checkEcho(request.method, request.url, request.headers, request.body, null))));
    final output = await rest.JsonServiceClient(rest.ClientConfig(endpoint: 'https://example.test', transport: fake)).echo(rest.ValuesInput(
        renamed: 'hello', whenValue: instant, iso: instant, date: instant, dates: [instant], query: instant,
        nullablePresence: const rest.Field.nullValue(), documentPresence: const rest.Field.nullValue(),
        floatValue: double.nan, doubleValue: double.infinity));
    expect((output.choice as rest.ChoiceText).value, 'ok');
    expect(output.nullablePresence.isSet, isFalse);
    expect(output.documentPresence.isSet, isTrue);
    expect(output.floatValue!.isNaN, isTrue);
    expect(output.doubleValue, double.infinity);
    expect(output.whenValue, instant);
    expect(output.date, rest.Timestamp(BigInt.from(-1)));
    expect(output.dates, [rest.Timestamp(BigInt.from(-1)), rest.Timestamp(BigInt.one)]);
    expect(fake.requests, hasLength(1));
  });

  test('awsJson1_0 and awsJson1_1 dispatch and body-only members', () async {
    for (final version in ['1.0', '1.1']) {
      Object? output;
      int sent;
      if (version == '1.0') {
        final fake = Json10Fake((request) => json10.HttpResponse(status: 200, body: bytes(checkEcho(request.method, request.url, request.headers, request.body, version))));
        output = await json10.JsonServiceClient(json10.ClientConfig(endpoint: 'https://example.test', transport: fake)).echo(json10.ValuesInput(
            renamed: 'hello', whenValue: json10.Timestamp(BigInt.from(-1), 750000000), iso: json10.Timestamp(BigInt.from(-1), 750000000),
            date: json10.Timestamp(BigInt.from(-1), 750000000), dates: [json10.Timestamp(BigInt.from(-1), 750000000)], query: json10.Timestamp(BigInt.from(-1), 750000000),
            nullablePresence: const json10.Field.nullValue(), documentPresence: const json10.Field.nullValue(),
            floatValue: double.nan, doubleValue: double.infinity));
        expect(((output as json10.ValuesOutput).choice as json10.ChoiceText).value, 'ok');
        expect(output.nullablePresence.isSet, isFalse);
        sent = fake.requests.length;
      } else {
        final fake = Json11Fake((request) => json11.HttpResponse(status: 200, body: bytes(checkEcho(request.method, request.url, request.headers, request.body, version))));
        output = await json11.JsonServiceClient(json11.ClientConfig(endpoint: 'https://example.test', transport: fake)).echo(json11.ValuesInput(
            renamed: 'hello', whenValue: json11.Timestamp(BigInt.from(-1), 750000000), iso: json11.Timestamp(BigInt.from(-1), 750000000),
            date: json11.Timestamp(BigInt.from(-1), 750000000), dates: [json11.Timestamp(BigInt.from(-1), 750000000)], query: json11.Timestamp(BigInt.from(-1), 750000000),
            nullablePresence: const json11.Field.nullValue(), documentPresence: const json11.Field.nullValue(),
            floatValue: double.nan, doubleValue: double.infinity));
        expect(((output as json11.ValuesOutput).choice as json11.ChoiceText).value, 'ok');
        expect(output.date, json11.Timestamp(BigInt.from(-1), 750000000));
        sent = fake.requests.length;
      }
      expect(sent, 1);
    }
  });

  test('AWS JSON error discriminators, request ids and empty operations', () async {
    for (final body in [
      {'code': 'Problem', 'Message': 'bad'},
      {'__type': 'example.json#Problem', 'Message': 'bad'},
      {'__type': 'aws.example#Problem:http://internal.example/', 'Message': 'bad'},
    ]) {
      final problem = rest.HttpResponse(status: 409, headers: {'x-amzn-requestid': 'request-42'}, body: bytes(body));
      final error = await rest.JsonServiceClient(rest.ClientConfig(endpoint: 'https://example.test', transport: RestFake((_) => problem)))
          .echo(const rest.ValuesInput()).then<Object>((_) => fail('Expected error'), onError: (Object error) => error);
      expect(error, isA<rest.Problem>());
      final metadata = (error as rest.ServiceError).metadata;
      expect(metadata.name, 'Problem');
      expect(metadata.requestId, 'request-42');
      expect(metadata.message, 'bad');
      final json = json11.HttpResponse(status: 400, headers: {'x-amzn-errortype': 'Problem:http://internal.example/', 'x-amz-request-id': 'other'}, body: bytes({'message': 'header'}));
      final jsonError = await json11.JsonServiceClient(json11.ClientConfig(endpoint: 'https://example.test', transport: Json11Fake((_) => json)))
          .echo(const json11.ValuesInput()).then<Object>((_) => fail('Expected error'), onError: (Object error) => error);
      expect(jsonError, isA<json11.Problem>().having((e) => e.metadata.requestId, 'requestId', 'other').having((e) => e.metadata.message, 'message', 'header'));
    }
    final restEmpty = RestFake((request) {
      expect(request.body, isNull);
      expect(request.url.path, '/empty');
      return rest.HttpResponse(status: 204);
    });
    await rest.JsonServiceClient(rest.ClientConfig(endpoint: 'https://example.test', transport: restEmpty)).empty();
    final jsonEmpty = Json10Fake((request) {
      expect(utf8.decode(request.body!), '{}');
      expect(request.headers['x-amz-target'], 'JsonService.Empty');
      expect(request.headers['content-type'], 'application/x-amz-json-1.0');
      return json10.HttpResponse(status: 200);
    });
    await json10.JsonServiceClient(json10.ClientConfig(endpoint: 'https://example.test', transport: jsonEmpty)).empty();
    expect(jsonEmpty.requests, hasLength(1));
  });
}
