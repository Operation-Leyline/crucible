@TestOn('vm')
library;

import 'dart:io';
import 'package:test/test.dart';
import 'package:auth_client/auth_client.dart';

void main() {
  test('environment and profile credentials on native platforms', () async {
    final environment = Platform.environment;
    expect(environment['CRUCIBLE_TEST_AWS'], 'set', reason: 'run by tools/test-dart.py with test environment variables');
    final identity = environmentCredentials()!;
    expect(identity.accessKeyId, 'env');
    expect(identity.sessionToken, 'token');
    final folder = await Directory.systemTemp.createTemp('crucible-dart-auth');
    try {
      final file = File('${folder.path}/credentials')
        ..writeAsStringSync('[default]\naws_access_key_id=other\naws_secret_access_key=x\n\n[test]\naws_access_key_id = profile\naws_secret_access_key = secret%with-percent\n');
      expect(profileCredentials(profile: 'test', path: file.path)!.secretAccessKey, 'secret%with-percent');
      expect(profileCredentials(profile: 'missing', path: file.path), isNull);
      expect(profileCredentials(path: '${folder.path}/absent'), isNull);
      File('${folder.path}/partial').writeAsStringSync('[default]\naws_access_key_id=only\n');
      expect(() => profileCredentials(profile: 'default', path: '${folder.path}/partial'), throwsStateError);
    } finally {
      await folder.delete(recursive: true);
    }
  });
}
