import 'dart:async';
import 'dart:convert';
import 'dart:typed_data';
import 'package:test/test.dart';
import 'package:behavior_client/behavior_client.dart';
import 'package:behavior_client/src/runtime/endpoints.dart';

final class Fake implements HttpTransport {
  final requests = <HttpRequest>[];
  @override
  Future<HttpResponse> send(HttpRequest request, {required bool readBody, required CancellationToken cancellation}) async {
    requests.add(request);
    return HttpResponse(status: 200, body: Uint8List.fromList(utf8.encode('{"wire-status":"READY"}')));
  }

  @override
  void close() {}
}

void main() {
  test('generated resolution, host prefix, endpoint headers and signing properties', () async {
    final fake = Fake();
    final credentials = AwsCredentials('key', 'secret');
    var client = ServiceClient(ClientConfig(transport: fake, region: 'local', credentials: () => credentials));
    final output = await client.read(const Input(account: 'customer'));
    expect(output.status, 'READY');
    final sent = fake.requests.last;
    expect(sent.url.toString(), 'https://customer.local.example.test/resource');
    expect(sent.headers['x-region'], 'local');
    expect(sent.headers['authorization'], contains('/local/example/aws4_request'));
    expect(sent.headers['x-amz-content-sha256'], 'UNSIGNED-PAYLOAD');
    for (final label in ['a.b', '-bad', 'x/y', 'x@evil', '', 'x' * 64]) {
      await expectLater(client.read(Input(account: label)), throwsA(isA<EndpointException>().having((e) => e.message, 'message', contains('host label'))));
    }
    expect(fake.requests, hasLength(1));
    expect(await client.waitUntilReady(const Input(account: 'customer'), timeout: const Duration(seconds: 1)), isA<Output>());
    client = ServiceClient(ClientConfig(transport: fake, region: 'local', credentials: () => credentials, disableHostPrefix: true));
    await client.read(const Input(account: 'ignored'));
    expect(fake.requests.last.url.host, 'local.example.test');
    client = ServiceClient(ClientConfig(transport: fake, region: 'missing', credentials: () => credentials));
    await expectLater(client.read(const Input(account: 'customer')), throwsA(isA<EndpointException>().having((e) => e.message, 'message', 'Unknown region missing')));
    client = ServiceClient(ClientConfig(transport: fake, credentials: () => credentials));
    await expectLater(client.read(const Input(account: 'customer')), throwsA(isA<EndpointException>().having((e) => e.message, 'message', contains('Region'))));
    // An optional, anonymous operation still resolves its endpoint.
    await ServiceClient(ClientConfig(transport: fake, region: 'local')).public();
    expect(fake.requests.last.headers.containsKey('authorization'), isFalse);
    expect(fake.requests.last.url.toString(), 'https://local.example.test/public');
  });

  test('parameter precedence, required parameters, types and false values', () {
    Map<String, Object?> ref(String name) => {'kind': 'reference', 'name': name};
    Map<String, Object?> text(String value) => {'kind': 'string', 'parts': [{'kind': 'literal', 'value': value}]};
    final rules = <String, Object?>{
      'parameters': {'Name': {'kind': 'string', 'required': true}, 'Flag': {'kind': 'boolean', 'required': true}},
      'rules': [
        {'conditions': [{'function': 'isSet', 'arguments': [ref('Flag')], 'assign': null}],
          'result': {'kind': 'endpoint', 'url': text('https://example.test/base'), 'headers': {'name': [ref('Name')]}, 'properties': {'flag': ref('Flag')}}}
      ],
    };
    final sources = <String, Object?>{
      'Name': [{'kind': 'inputMember', 'member': 'name'}, {'kind': 'client', 'name': 'name'}, {'kind': 'default', 'value': 'default'}],
      'Flag': [{'kind': 'builtIn', 'name': 'Flag'}],
    };
    final result = resolveEndpoint(rules, sources, {'name': 'input'}, {'name': 'client'}, {'Flag': false});
    expect(result.headers['name'], ['input']);
    expect(result.properties['flag'], isFalse);
    expect(resolveEndpoint(rules, sources, <String, Object?>{}, {'name': 'client'}, {'Flag': false}).headers['name'], ['client']);
    expect(resolveEndpoint(rules, sources, <String, Object?>{}, {}, {'Flag': false}).headers['name'], ['default']);
    expect(() => resolveEndpoint(rules, sources, <String, Object?>{}, {}, {}), throwsA(isA<EndpointException>().having((e) => e.message, 'message', contains('missing'))));
    expect(() => resolveEndpoint(rules, sources, <String, Object?>{}, {}, {'Flag': 'no'}), throwsA(isA<EndpointException>().having((e) => e.message, 'message', contains('wrong type'))));
    expect(() => ClientConfig(endpointParameters: {'bad': 1}), throwsArgumentError);
  });

  test('standard rules functions and invalid endpoints', () {
    expect(parseEndpointUrl('https://example.test:443/a')!['authority'], 'example.test');
    expect(parseEndpointUrl('https://example.test:8443/a')!['normalizedPath'], '/a/');
    expect(parseEndpointUrl('https://[::1]:8443')!['authority'], '[::1]:8443');
    expect(parseEndpointUrl('https://[::1]')!['isIp'], isTrue);
    expect(parseEndpointUrl('http://10.0.0.1')!['isIp'], isTrue);
    for (final value in ['file:///path', 'https://user:password@example.test', 'https://example.test?q=x', 'https://example.test#x', 'https://example.test:99999', 'https://evil\n.example']) {
      expect(parseEndpointUrl(value), isNull, reason: value);
    }
    expect(endpointFunction('substring', ['abcdef', JsonNumber('1'), JsonNumber('3'), true]), 'de');
    expect(endpointFunction('substring', ['é', JsonNumber('0'), JsonNumber('1'), false]), isNull);
    expect(endpointFunction('substring', ['a', JsonNumber('0'), JsonNumber('2'), false]), isNull);
    expect(endpointFunction('uriEncode', ['a/b +é']), 'a%2Fb%20%2B%C3%A9');
    expect(endpointFunction('getAttr', [{'items': ['a', 'b']}, 'items[1]']), 'b');
    expect(endpointFunction('getAttr', [{'items': ['a', 'b']}, 'items[5]']), isNull);
    expect(endpointFunction('isSet', [false]), isTrue);
    expect(endpointFunction('isValidHostLabel', ['x.y', false]), isFalse);
    expect(endpointFunction('isValidHostLabel', ['x.y', true]), isTrue);
    expect(endpointFunction('booleanEquals', [true, 'true']), isFalse);
    expect(() => endpointFunction('not', ['true']), throwsA(isA<EndpointException>()));
  });
}
