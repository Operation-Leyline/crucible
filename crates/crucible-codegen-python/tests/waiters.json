{
 "smithy":"2.0",
 "shapes":{
  "example.wait#Jobs":{"type":"service","version":"1","traits":{"crucible.protocols#json":{}},"operations":[{"target":"example.wait#Read"}]},
  "example.wait#Read":{"type":"operation","traits":{
   "smithy.api#http":{"method":"POST","uri":"/read"},"smithy.api#readonly":{},
   "smithy.waiters#waitable":{
    "Ready":{"minDelay":1,"maxDelay":4,"acceptors":[
     {"state":"success","matcher":{"output":{"path":"status","comparator":"stringEquals","expected":"READY"}}},
     {"state":"failure","matcher":{"output":{"path":"status","comparator":"stringEquals","expected":"FAILED"}},"message":"reasons"},
     {"state":"retry","matcher":{"errorType":"example.wait#Missing"}}
    ]},
    "AllReady":{"acceptors":[{"state":"success","matcher":{"output":{"path":"items[].status","comparator":"allStringEquals","expected":"READY"}}}]},
    "AnyReady":{"acceptors":[{"state":"success","matcher":{"output":{"path":"items[].status","comparator":"anyStringEquals","expected":"READY"}}}]},
    "FilteredReady":{"acceptors":[{"state":"success","matcher":{"output":{"path":"length(items[?status == 'READY']) == length(items) && length(items) > `0`","comparator":"booleanEquals","expected":"true"}}}]},
    "CountsMatch":{"acceptors":[{"state":"success","matcher":{"inputOutput":{"path":"length(input.names) == length(output.items)","comparator":"booleanEquals","expected":"true"}}}]},
    "Updated":{"acceptors":[{"state":"success","matcher":{"output":{"path":"updatedAt > `0`","comparator":"booleanEquals","expected":"true"}}}]}
   }
  },"input":{"target":"example.wait#Input"},"output":{"target":"example.wait#Output"}},
  "example.wait#Input":{"type":"structure","traits":{"smithy.api#input":{}},"members":{"names":{"target":"example.wait#Names"}}},
  "example.wait#Output":{"type":"structure","members":{"status":{"target":"smithy.api#String","traits":{"smithy.api#jsonName":"wire-status"}},"items":{"target":"example.wait#Items"},"reasons":{"target":"example.wait#Names"},"updatedAt":{"target":"smithy.api#Timestamp"}}},
  "example.wait#Item":{"type":"structure","members":{"status":{"target":"smithy.api#String","traits":{"smithy.api#jsonName":"wire-status"}}}},
  "example.wait#Items":{"type":"list","member":{"target":"example.wait#Item"}},
  "example.wait#Names":{"type":"list","member":{"target":"smithy.api#String"}}
 }
}
