{
  "smithy": "2.0",
  "shapes": {
    "example.recursion#Service": {
      "type": "service",
      "version": "1",
      "traits": { "crucible.protocols#json": {} },
      "operations": [{ "target": "example.recursion#Get" }]
    },
    "example.recursion#Get": {
      "type": "operation",
      "traits": { "smithy.api#http": { "method": "POST", "uri": "/get", "code": 200 } },
      "input": { "target": "example.recursion#Input" },
      "output": { "target": "example.recursion#Node" }
    },
    "example.recursion#Input": {
      "type": "structure",
      "members": { "id": { "target": "smithy.api#String", "traits": { "smithy.api#required": {} } } }
    },
    "example.recursion#Node": {
      "type": "structure",
      "members": { "children": { "target": "example.recursion#Nodes" } }
    },
    "example.recursion#Nodes": {
      "type": "list",
      "member": { "target": "example.recursion#Node" }
    }
  }
}
