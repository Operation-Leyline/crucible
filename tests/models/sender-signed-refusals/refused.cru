service Refused {
    version "1"
    protocol json
    auth bearer
    operations [NotAnonymous, BodySignature, NoSuchMember, Unnamed, WrongArguments]
    resources [Hook]
}

resource Hook {
    id hookId: string
}

@sender("Stripe", signature: signature)
anonymous operation CreateHook creates Hook {
    http POST "/hooks"
    input {
        @header("Stripe-Signature")
        signature: string
    }
    output {
        $hookId
    }
}

@sender("Stripe", signature: signature)
operation NotAnonymous {
    http POST "/not-anonymous"
    input {
        @header("Stripe-Signature")
        signature: string
    }
}

@sender("Stripe", signature: signature)
anonymous operation BodySignature {
    http POST "/body-signature"
    input {
        signature: string
    }
}

@sender("Stripe", signature: missing)
anonymous operation NoSuchMember {
    http POST "/no-such-member"
    input {
        @header("Stripe-Signature")
        signature: string
    }
}

@sender(" ", signature: signature)
anonymous operation Unnamed {
    http POST "/unnamed"
    input {
        @header("Stripe-Signature")
        signature: string
    }
}

@sender(signature: "Stripe-Signature")
anonymous operation WrongArguments {
    http POST "/wrong-arguments"
    input {
        @header("Stripe-Signature")
        signature: string
    }
}

@sender("Stripe", signature: value)
structure Misplaced {
    value: string
}
