/// Operations with and without examples, and errors with and without one.
service Coverage {
    version "1"
    protocol json
    operations [GetNote, ListNotes, Ping]
    errors [Throttled]
}

/// No note has that id.
error NoteNotFound {
    status 404
    message: string
}

/// Someone else is editing the note.
error NoteLocked {
    status 409
    message: string
}

error Throttled {
    status 429
    retryable throttling
    message: string
}

structure Note {
    id: string
    text: string
}

list Notes: Note
