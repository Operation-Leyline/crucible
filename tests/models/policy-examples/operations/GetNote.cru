/// Reads a note: it has examples, though none of NoteLocked.
readonly operation GetNote {
    http GET "/notes/{id}"
    input {
        id: string
    }
    output {
        note: Note
    }
    errors [NoteNotFound, NoteLocked]
    example "Read a note" {
        input { id: "n-1" }
        output { note: { id: "n-1", text: "Buy milk" } }
    }
    example "Read a missing note" {
        input { id: "n-2" }
        error NoteNotFound { message: "No note n-2" }
    }
}
