/// Paginated, with the page token in the query and no example: the
/// sample's token is none the service issued, so no SDK snippet or `http`
/// request sends it.
readonly operation ListGraphs {
    http GET "/graphs"
    paginated(inputToken: nextToken, outputToken: nextToken, items: graphIds, pageSize: maxResults)
    input {
        @query
        nextToken?: string
        @query
        maxResults?: integer { range 1..100 }
    }
    output {
        graphIds: GraphIds
        nextToken?: string
    }
}
