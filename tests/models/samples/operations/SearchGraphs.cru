/// Paginated, with the page token in the body beside the query, and no
/// example: no SDK snippet or `http` request sends it.
readonly operation SearchGraphs {
    http POST "/graphs/search"
    paginated(inputToken: pageToken, outputToken: pageToken, items: graphIds)
    input {
        query: GraphName
        pageToken?: string
    }
    output {
        graphIds: GraphIds
        pageToken?: string
    }
}
