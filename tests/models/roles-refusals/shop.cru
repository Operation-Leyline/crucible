service Shop {
    version "1"
    protocol json
    auth bearer
    notFound Missing
    resources [Store]
    principals PrincipalKind
    scopes [store, shelf, outlet]
    roles [keeper, shelfClerk, a, b, stray, robotKeeper, deputy, manager]
}

error Missing {
    status 404
    message: string
}

string StoreId { length 1..40 }
string ShelfId { length 1..40 }
string LedgerId { length 1..40 }

resource Store {
    id storeId: StoreId
    permission read = "store:read"
}

resource Shelf in Store {
    id shelfId: ShelfId
    permission read = "shelf:read"
    permission stock = "shelf:stock"
}

resource Ledger in Store {
    id ledgerId: LedgerId
    permission read = "ledger:read"
}

readonly operation GetStore on Store {
    http GET "/stores/{storeId}"
    requires read
    input {
        $storeId
    }
}

readonly operation GetShelf on Shelf {
    http GET "/stores/{storeId}/shelves/{shelfId}"
    requires read
    input {
        $storeId
        $shelfId
    }
}

operation StockShelf on Shelf {
    http POST "/stores/{storeId}/shelves/{shelfId}/stock"
    requires stock
    input {
        $storeId
        $shelfId
    }
}

readonly operation GetLedger on Ledger {
    http GET "/stores/{storeId}/ledgers/{ledgerId}"
    requires read
    input {
        $storeId
        $ledgerId
    }
}

/// Who holds a credential.
enum PrincipalKind {
    USER = "user"
}

scope store = "store" on Store
scope shelf = "shelf" on Shelf
scope outlet = "store" on Store

/// Everything but the ledgers, which no role grants.
role keeper = "keeper" {
    at [store]
    grants Store [read]
    grants Shelf [read, stock]
}

role shelfClerk = "shelfClerk" { at [shelf]; grants Store [read] }
role a = "a" { at [store]; includes [b] }
role b = "b" { at [store]; includes [a] }
role stray = "stray" { at [nowhere]; grants Store [read] }
role robotKeeper = "robotKeeper" { at [store]; holders [ROBOT]; grants Store [read] }
role deputy = "deputy" { at [store]; assignedBy [mayor]; grants Store [read] }
role manager = "keeper" { at [store]; grants Store [read] }

/// Missing every role but `keeper`.
@roleTypes
enum RoleName {
    KEEPER = "keeper"
}

/// Uses the enum, so it is part of the contract.
readonly operation DescribeRole {
    http GET "/role"
    requires none
    output {
        role: RoleName
    }
}
