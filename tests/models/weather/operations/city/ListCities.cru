operation ListCities lists City {
    http GET "/cities"
    paginated(items: cities, pageSize: maxResults)
    input {
        @query
        nextToken?: string
        @query
        maxResults?: integer { range 1..100 }
        @query("tag")
        tags?: Tags
    }
    output {
        cities: CitySummaries
        nextToken?: string
    }
    example "List the first page" {
        input { maxResults: 2, tags: ["coastal", "capital"] }
        output { cities: [{ id: "c-0a1b2c3d", name: "Lisbon" }], nextToken: "page-2" }
    }
}
