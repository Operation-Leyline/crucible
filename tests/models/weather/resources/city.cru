string CityId { pattern "^c-[a-z0-9]{8}$" }

string CityName { length 1..100 }

list CitySummaries: CitySummary

structure CitySummary {
    id: CityId
    name: CityName
    population: long = 0
    updatedAt?: timestamp
    @deprecated(since: "2026-08", message: "Use updatedAt.")
    createdAt?: timestamp { format epoch-seconds }
}

structure Coordinates {
    latitude: double
    longitude: double
}

timestamp DateTime { format date-time }

map Forecast: Sky -> document

union Location {
    coordinates: Coordinates
    unknown
}

/// A photo, carried unparsed.
blob Photo { length 1..4096; mediaType "image/jpeg" }

@since("2026-10")
@unstable
@externalDocs("Reference" = "https://weather.example/docs/photos/reference", "Photo guide" = "https://weather.example/docs/photos")
structure PhotoSummary {
    size: integer
    thumbnail: Thumbnail
    caption?: string
}

enum Sky {
    CLEAR = "clear"
    @deprecated(message: "Reported as CLEAR with a cloud cover reading.")
    CLOUDY = "cloudy"
}

list Tags: string { length ..5 }

/// The photo's first bytes: base64 in JSON.
blob Thumbnail { length ..8 }

resource City {
    id cityId: CityId
}
