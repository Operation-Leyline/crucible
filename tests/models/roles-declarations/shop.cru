service Shop {
    version "1"
    protocol json
    auth bearer
    notFound Missing
    resources [Store]
    principals Store
    scopes [store, store, orphanScope]
    roles [keeper, nowhere, ghostly, badValue, twice]
}

error Missing {
    status 404
    message: string
}

string StoreId { length 1..40 }
string ShelfId { length 1..40 }
string LedgerId { length 1..40 }

resource Store {
    id storeId: StoreId
    permission read = "store:read"
}

resource Shelf in Store {
    id shelfId: ShelfId
    permission read = "shelf:read"
    permission stock = "shelf:stock"
}

resource Ledger in Store {
    id ledgerId: LedgerId
    permission read = "ledger:read"
}

readonly operation GetStore on Store {
    http GET "/stores/{storeId}"
    requires read
    input {
        $storeId
    }
}

readonly operation GetShelf on Shelf {
    http GET "/stores/{storeId}/shelves/{shelfId}"
    requires read
    input {
        $storeId
        $shelfId
    }
}

operation StockShelf on Shelf {
    http POST "/stores/{storeId}/shelves/{shelfId}/stock"
    requires stock
    input {
        $storeId
        $shelfId
    }
}

readonly operation GetLedger on Ledger {
    http GET "/stores/{storeId}/ledgers/{ledgerId}"
    requires read
    input {
        $storeId
        $ledgerId
    }
}

scope store = "store" on Store
/// Not a resource of the service.
scope orphanScope = "orphan" on Orphan
scope forgotten = "forgotten" on Store
/// Everything in a store.
role keeper = "keeper" {
    at [store]
    grants Store [read]
    grants Shelf [read, stock]
    grants Ledger [read]
}

/// Bound nowhere.
role nowhere = "nowhere" { grants Store [read] }

/// Includes a role the service does not have.
role ghostly = "ghostly" { at [store]; includes [phantom] }

role badValue = "Bad Value" { at [store]; grants Store [read] }

@permissionTypes
role twice = "twice" {
    at [store]
    at [store]
    holders [USER, USER]
    grants Store [read]
}

role forgottenRole = "forgottenRole" { at [store]; grants Store [read] }

string OrphanId { length 1..40 }

resource Orphan {
    id orphanId: OrphanId
}
