service Shop {
    version "1"
    protocol json
    auth bearer
    notFound Missing
    resources [Store]
    scopes [store, shelf]
    roles [keeper, shelver]
}

error Missing {
    status 404
    message: string
}

string StoreId { length 1..40 }
string ShelfId { length 1..40 }
string LedgerId { length 1..40 }

resource Store {
    id storeId: StoreId
    permission read = "store:read"
}

resource Shelf in Store {
    id shelfId: ShelfId
    permission read = "shelf:read"
    permission stock = "shelf:stock"
}

resource Ledger in Store {
    id ledgerId: LedgerId
    permission read = "ledger:read"
}

readonly operation GetStore on Store {
    http GET "/stores/{storeId}"
    requires read
    input {
        $storeId
    }
}

readonly operation GetShelf on Shelf {
    http GET "/stores/{storeId}/shelves/{shelfId}"
    requires read
    input {
        $storeId
        $shelfId
    }
}

operation StockShelf on Shelf {
    http POST "/stores/{storeId}/shelves/{shelfId}/stock"
    requires stock
    input {
        $storeId
        $shelfId
    }
}

readonly operation GetLedger on Ledger {
    http GET "/stores/{storeId}/ledgers/{ledgerId}"
    requires read
    input {
        $storeId
        $ledgerId
    }
}

scope store = "store" on Store
scope shelf = "shelf" on Shelf
/// Everything in a store.
role keeper = "keeper" {
    at [store]
    grants Store [read]
    grants Shelf [read, stock]
    grants Ledger [read]
}

role shelver = "shelver" { at [shelf]; grants Shelf [stock] }

/// The roles a binding names: one too many, one missing.
@roleTypes
enum RoleName {
    KEEPER = "keeper"
    GHOST = "ghost"
}

/// The scopes a binding names: one missing.
@scopeTypes
enum ScopeName {
    STORE = "store"
}

/// Uses both enums, so they are part of the contract.
structure Binding {
    role: RoleName
    scope: ScopeName
}

readonly operation DescribeBinding {
    http GET "/binding"
    requires none
    output {
        binding: Binding
    }
}
