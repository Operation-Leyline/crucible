service Shop {
    version "2"
    protocol json
    auth bearer
    notFound Missing
    resources [Store]
    principals PrincipalType
    scopes [store, shelf]
    roles [keeper, stocker]
}

error Missing {
    status 404
    message: string
}

/// Who a credential belongs to.
enum PrincipalType {
    USER = "user"
    API_KEY = "apiKey"
}

string StoreId { length 1..40 }
string ShelfId { length 1..40 }

resource Store {
    id storeId: StoreId
    permission read = "store:read"
}

readonly operation GetStore on Store {
    http GET "/stores/{storeId}"
    requires read
    input {
        $storeId
    }
}

resource Shelf in Store {
    id shelfId: ShelfId
    permission read = "shelf:read"
    permission stock = "shelf:stock"
}

readonly operation GetShelf on Shelf {
    http GET "/stores/{storeId}/shelves/{shelfId}"
    requires read
    input {
        $storeId
        $shelfId
    }
}

operation StockShelf on Shelf {
    http POST "/stores/{storeId}/shelves/{shelfId}/stock"
    requires stock
    input {
        $storeId
        $shelfId
    }
}

/// One store and everything in it.
scope store = "store" on Store
/// One shelf.
scope shelf = "shelf" on Shelf

/// Runs the store.
role keeper = "keeper" {
    at [store]
    holders [USER]
    grants Store [*]
    grants Shelf [*]
}

/// Reads and stocks shelves.
role stocker = "stocker" {
    at [shelf]
    holders [USER]
    grants Shelf [read, stock]
}

/// Stocking is a person's job, one shelf at a time; `browser` is gone, and
/// shelves are read through the store's own pages.
migration "2" from "1" {
    /// Keys no longer stock shelves.
    narrow role stocker
    remove role browser
    remove scope everyShelf
}
