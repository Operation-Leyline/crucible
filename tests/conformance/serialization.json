  {
    "id": "timestamp-offset",
    "target": "example.weather#CitySummary",
    "wire": "{\"id\":\"c\",\"name\":\"n\",\"updatedAt\":\"1970-01-01T01:00:00.125+01:00\"}",
    "expect": {
      "json": "{\"id\":\"c\",\"name\":\"n\",\"population\":0,\"updatedAt\":\"1970-01-01T00:00:00.125Z\"}",
      "instant": {
        "member": "updatedAt",
        "seconds": "0",
        "nanoseconds": 125000000
      }
    },
    "expectByProfile": {
      "python-datetime": {
        "json": "{\"id\":\"c\",\"name\":\"n\",\"population\":0,\"updatedAt\":\"1970-01-01T00:00:00.125000Z\"}",
        "instant": {
          "member": "updatedAt",
          "seconds": "0",
          "nanoseconds": 125000000
        }
      }
    }
  },
