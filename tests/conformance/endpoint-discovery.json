{
  "description": "Endpoint discovery scenarios for a client generated from crates/crucible-smithy/tests/fixtures/runtime-policy.json with endpoint https://records.example, api key 'key', backoff disabled and an injected clock starting at 0. Each scenario uses a fresh client. 'endpointDiscovery' is the client setting (null: required operations only). A step either advances the clock by 'advance' seconds or makes a call; every HTTP request the call sends must match the next exchange's method, URL and (when given) JSON body, and receives that exchange's response. 'outcome' is success, a modeled or wire error name, or 'endpoint-discovery' for the runtime's discovery error.",
  "scenarios": [
    {
      "name": "required-discovers-once-and-caches-for-the-period",
      "endpointDiscovery": null,
      "steps": [
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k1" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "GetRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "t1.records.example", "CachePeriodInMinutes": 1 }] } } },
            { "method": "GET", "url": "https://t1.records.example/records/t1/k1", "response": { "status": 200, "json": { "value": "a" } } }
          ],
          "outcome": "success"
        },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k2" },
          "exchanges": [
            { "method": "GET", "url": "https://t1.records.example/records/t1/k2", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        { "advance": 59.9 },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k3" },
          "exchanges": [
            { "method": "GET", "url": "https://t1.records.example/records/t1/k3", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        { "advance": 0.1 },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k4" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "GetRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "https://t1b.records.example", "CachePeriodInMinutes": 5 }] } } },
            { "method": "GET", "url": "https://t1b.records.example/records/t1/k4", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "identifiers-and-operation-key-the-cache",
      "endpointDiscovery": true,
      "steps": [
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "GetRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "t1.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://t1.records.example/records/t1/k", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        {
          "call": "GetRecord", "input": { "table": "t2", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "GetRecord", "Identifiers": { "table": "t2" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "t2.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://t2.records.example/records/t2/k", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "PutRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "w1.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "POST", "url": "https://w1.records.example/records/t1", "json": { "value": "v" }, "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "GET", "url": "https://t1.records.example/records/t1/k", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "misdirected-request-invalidates-and-rediscovers",
      "endpointDiscovery": null,
      "steps": [
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "GetRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "old.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://old.records.example/records/t1/k", "response": { "status": 421, "json": {} } },
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "GetRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "new.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://new.records.example/records/t1/k", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "modeled-invalid-endpoint-error-resends-even-a-write",
      "endpointDiscovery": true,
      "steps": [
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "PutRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "old.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "POST", "url": "https://old.records.example/records/t1", "response": { "status": 400, "json": { "__type": "InvalidEndpointException" } } },
            { "method": "POST", "url": "https://records.example/endpoints", "json": { "Operation": "PutRecord", "Identifiers": { "table": "t1" } },
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "new.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "POST", "url": "https://new.records.example/records/t1", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "invalidation-still-respects-the-attempt-limit",
      "endpointDiscovery": null,
      "maxAttempts": 1,
      "steps": [
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints",
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "old.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://old.records.example/records/t1/k", "response": { "status": 421, "json": { "__type": "InvalidEndpointException" } } }
          ],
          "outcome": "InvalidEndpointException"
        },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints",
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "new.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://new.records.example/records/t1/k", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "optional-uses-the-configured-endpoint-by-default",
      "endpointDiscovery": null,
      "steps": [
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/records/t1", "json": { "value": "v" }, "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "optional-failure-falls-back-for-sixty-seconds",
      "endpointDiscovery": true,
      "steps": [
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "response": { "status": 400, "json": { "__type": "Denied" } } },
            { "method": "POST", "url": "https://records.example/records/t1", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        { "advance": 59 },
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/records/t1", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        },
        { "advance": 1 },
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints",
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "w1.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "POST", "url": "https://w1.records.example/records/t1", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "required-failure-is-the-call-failure",
      "endpointDiscovery": null,
      "steps": [
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "response": { "status": 400, "json": { "__type": "Denied" } } }
          ],
          "outcome": "Denied"
        },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "response": { "status": 200, "json": { "Endpoints": [] } } }
          ],
          "outcome": "endpoint-discovery"
        },
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints",
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "not a host", "CachePeriodInMinutes": 10 }] } } }
          ],
          "outcome": "endpoint-discovery"
        }
      ]
    },
    {
      "name": "discovery-is-retried-under-the-discovery-operations-policy",
      "endpointDiscovery": null,
      "steps": [
        {
          "call": "GetRecord", "input": { "table": "t1", "key": "k" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/endpoints", "response": { "status": 503, "json": {} } },
            { "method": "POST", "url": "https://records.example/endpoints",
              "response": { "status": 200, "json": { "Endpoints": [{ "Address": "t1.records.example", "CachePeriodInMinutes": 10 }] } } },
            { "method": "GET", "url": "https://t1.records.example/records/t1/k", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
      ]
    },
    {
      "name": "disabled-discovery-rejects-required-operations-before-sending",
      "endpointDiscovery": false,
      "steps": [
        { "call": "GetRecord", "input": { "table": "t1", "key": "k" }, "exchanges": [], "outcome": "endpoint-discovery" },
        {
          "call": "PutRecord", "input": { "table": "t1", "value": "v" },
          "exchanges": [
            { "method": "POST", "url": "https://records.example/records/t1", "response": { "status": 200, "json": {} } }
          ],
          "outcome": "success"
        }
