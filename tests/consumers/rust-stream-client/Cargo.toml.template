[package]
name = "rust-stream-client-consumer"
version = "0.0.0"
edition = "2024"
publish = false
[workspace]
[dependencies]
streams-sdk = { path = "../sdk" }
empty-streams-sdk = { path = "../empty-sdk" }
streaming-consumer = { path = "@ROOT@/tests/consumers/streaming" }
crucible-server-runtime-rust = { path = "@ROOT@/crates/crucible-server-runtime-rust" }
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "time", "io-util"] }
axum = "0.8"
reqwest = { version = "0.13.5", default-features = false }
futures-util = "0.3"
serde_json = { version = "1", features = ["preserve_order", "arbitrary_precision"] }
