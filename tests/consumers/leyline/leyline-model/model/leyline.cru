/// A graph service in the shape of a real Crucible consumer: bearer
/// authentication, modelled refusals and validation errors.
service Leyline {
    version "1"
    protocol json
    auth bearer
    operations [Health, GetGraph, CreateGraph]
    errors [AccessDeniedException, ValidationException, InternalServerException, UnknownOperationException]
}

/// Liveness probe; public.
readonly public operation Health {
    http GET "/health" -> 200
    output {
        status: string
    }
}

/// Read a graph.
readonly operation GetGraph {
    http GET "/graphs/{graphId}" -> 200
    input {
        graphId: string
    }
    output {
        graphId: string
        name: string
    }
    errors [GraphNotFound]
}

/// Create a graph.
operation CreateGraph {
    http POST "/graphs" -> 201
    input {
        name: string { length 1..64 }
    }
    output {
        graphId: string
        name: string
    }
}

/// The credential is absent, invalid, or does not grant access.
error AccessDeniedException {
    status 401
    message: string
}

error GraphNotFound {
    status 404
    message: string
}
