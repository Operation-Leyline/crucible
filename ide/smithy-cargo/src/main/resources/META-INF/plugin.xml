<idea-plugin>
    <id>com.leyline.smithy.cargo</id>
    <name>Smithy Cargo</name>
    <version>0.1.0</version>
    <vendor url="https://github.com/Operation-Leyline/crucible">Leyline</vendor>
    <description>Expose resolved Cargo Smithy model dependencies and source folders to the Smithy language plugin.</description>
    <idea-version since-build="262" until-build="262.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>software.amazon.smithy.intellij</depends>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.leyline.smithy.cargo.CargoStartup"/>
        <additionalLibraryRootsProvider implementation="com.leyline.smithy.cargo.CargoLibraries"/>
        <resolveScopeProvider implementation="com.leyline.smithy.cargo.CargoScope"/>
        <notificationGroup id="Smithy Cargo" displayType="BALLOON"/>
    </extensions>
    <actions>
        <action id="com.leyline.smithy.cargo.Refresh" class="com.leyline.smithy.cargo.RefreshCargoModels"
                text="Refresh Cargo Smithy Models" description="Index the resolved Cargo prelude and trait dependencies">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
