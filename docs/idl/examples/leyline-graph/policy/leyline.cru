// Leyline's own rules, on top of org.standards (which it imports and cannot
// weaken).

/// Every operation is charged to exactly one request-rate class, and is either
/// classified for the audit journal or excluded from it with a reason.
rule Classified strict {
    every operation
    must has @operationClass
    must has one of @auditCategory, @auditExcluded
}

/// A class agrees with the operation's semantics, so a read can never land in a
/// write's bucket or the reverse.
rule ClassMatchesSemantics strict {
    every operation where @operationClass == controlRead
    must readonly
    every operation where @operationClass == controlWrite or @operationClass == asyncJob
    must not readonly
}

/// Only a control-plane write needs to say it still works while suspended: reads
/// always do, and queries and jobs never do.
rule SuspensionOnlyOnControlWrite strict {
    every operation where has @permittedWhileSuspended
    must @operationClass == controlWrite
}

/// Organization data is addressed under its organization, so every access log,
/// metric and WAF rule sees the tenant in the path.
rule TenantInPath strict {
    every operation where addresses Organization
    must http.uri startsWith "/v1/organizations/{organizationId}"
}

/// A public operation takes no credentials, so it is rate-limited on its own
/// and states why it is outside the audit journal.
rule PublicOperationsAreContained strict {
    every operation where public
    must has @ownRequestLimit
    must has @auditExcluded
}

/// Members target named, constrained shapes, never an inline primitive.
rule NoInlinePrimitives {
    every member where not template
    must not type is inline primitive
}

/// HTTP methods keep their meaning: GET and HEAD read, PUT and DELETE can be
/// repeated, and a readonly operation uses GET or HEAD. A batch read that must
/// carry its keys in a body is excepted below.
rule HttpMethodSemantics {
    every operation where http.method in [GET, HEAD]
    must readonly
    every operation where http.method in [PUT, DELETE]
    must idempotent or readonly
    every operation where readonly
    must http.method in [GET, HEAD]
}

/// A shape something reaches, or it is dead weight in the contract.
rule Referenced strict {
    every shape
    must referenced
}

// NoDocument is `exceptable` in org.standards, so Leyline may except it here,
// with a reason, and the exception is recorded in the compiled artifact.
except NoDocument for SearchTerms because "Match detail is index-specific JSON; the service bounds its size."
