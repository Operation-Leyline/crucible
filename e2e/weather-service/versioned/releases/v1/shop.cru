service Shop {
    version "v1"
    protocol json
    operations [GetItem, ListItems, DeleteItem, CountItems]
    errors [ValidationException, InternalServerException]
}

readonly operation GetItem {
    http GET "/items/{id}"
    input { id: string }
    errors [ItemNotFoundException]
    output {
        name: string
        size?: integer
        kind: Kind
    }
}

enum Kind { SMALL, LARGE }

readonly operation ListItems {
    http GET "/items"
    input {
        @query
        max?: integer
        @query
        sort?: string
    }
    output {
        names: Names
        kinds: Kinds
    }
}

list Names: string

list Kinds: Kind

idempotent operation DeleteItem {
    http DELETE "/items/{id}"
    input {
        id: string
        @query
        force?: boolean
    }
    output { deleted: boolean }
}

readonly operation CountItems {
    http GET "/count"
    input {
        @query
        shelf?: string
    }
    errors [CountUnavailableException]
    output { count: integer }
}

error ItemNotFoundException {
    status 404
    message: string
}

error CountUnavailableException {
    status 503
    message: string
}
