service Shop {
    version "v4"
    protocol json
    operations [GetItem, ListItems, ListLabels, GetLabel, PutLabel, DeleteItem, RecordPayment]
    errors [ValidationException, InternalServerException]
}

readonly operation GetItem {
    http GET "/things/{id}"
    input { id: string }
    errors [ItemNotFoundException, ItemGoneException]
    output {
        label: Label
        kind: Kind
    }
}

enum Kind { SMALL, LARGE, HUGE }

/// A payment processor's delivery (decision 81). The processor names no
/// release of the shop: it is served at the current one, v4, whatever the
/// service does with a client's request that names none.
@sender("Payments", signature: signature)
public operation RecordPayment {
    http POST "/payments"
    input {
        @header("Payment-Signature")
        signature: string
    }
    output { release: string }
}

readonly operation ListItems {
    http GET "/items"
    input {
        @query
        limit: integer
        @query
        sort: string
    }
    output {
        names: Names
        kinds: Kinds
    }
}

list Names: string

list Kinds: Kind

idempotent operation DeleteItem {
    http DELETE "/items/{id}"
    input {
        id: string
        @query
        force?: string
    }
    output { deleted: string }
}

error ItemNotFoundException {
    status 404
    message: string
}

// v2 renamed the item's name and made the sort order required: the order
// an older request did not send comes from the account (an async hook).
migration "v2" from "v1" {
    rename GetItem.output.name -> title
    rename ListItems.input.max -> limit
    require ListItems.input.sort by async hook
    sunset "2027-01-01"
}

/// An item's label. Strict: a request naming a member it does not have
/// is refused, at the current release; an older release's outputs reach it
/// too, so there it reads what it does not know.
strict structure Label {
    title: string
    size?: string
    color?: string
}

/// Every label on the shelf, and the kinds of item they mark. Added in v3,
/// it reaches v1 and v2 clients too (decision 51), its kinds as they know
/// them.
readonly operation ListLabels {
    http GET "/labels"
    output {
        labels: Labels
        kinds: Kinds
    }
}

list Labels: Label

/// One label. Added in v4, and served at every release.
readonly operation GetLabel {
    http GET "/labels/{id}"
    input { id: string }
    output { label: Label }
}

/// Replaces a label. Added in v4: its input reaches `Label`, so the
/// migration to v4 converts a size older clients send, as well as one
/// they receive.
idempotent operation PutLabel {
    http PUT "/labels/{id}"
    input {
        id: string
        label: Label
    }
    output { label: Label }
}

error ItemGoneException {
    status 410
    message: string
}

// v3 moved GetItem and grouped its title and size into a label, made the
// page size required, added a kind and an error, reports deletion as a
// status, and dropped CountItems.
migration "v3" from "v2" {
    move GetItem from GET "/items/{id}"
    reshape GetItem.output { title, size } -> label by hook
    require ListItems.input.limit default 20
    add Kind.HUGE downgrade LARGE
    add GetItem.errors ItemGoneException downgrade ItemNotFoundException {
        message <- message
    }
    retype DeleteItem.input.force -> string by hook
    retype DeleteItem.output.deleted -> string by hook
    remove operation CountItems
}

// v4 measures a label's size in words, and added a label's color and two
// operations on labels, which reach every release.
migration "v4" from "v3" {
    retype Label.size -> string by hook
}
