service Shop {
    version "v3"
    protocol json
    operations [GetItem, ListItems, DeleteItem]
    errors [ValidationException, InternalServerException]
}

readonly operation GetItem {
    http GET "/things/{id}"
    input { id: string }
    errors [ItemNotFoundException, ItemGoneException]
    output {
        title: string
        size?: integer
        kind: Kind
    }
}

enum Kind { SMALL, LARGE, HUGE }

readonly operation ListItems {
    http GET "/items"
    input {
        @query
        limit: integer
    }
    output { names: Names }
}

list Names: string

idempotent operation DeleteItem {
    http DELETE "/items/{id}"
    input { id: string }
    output { deleted: string }
}

error ItemNotFoundException {
    status 404
    message: string
}

// v2 renamed the item's name.
migration "v2" from "v1" {
    rename GetItem.output.name -> title
    sunset "2027-01-01"
}

error ItemGoneException {
    status 410
    message: string
}

// v3 moved GetItem, made the page size required, added a kind and an
// error, and reports deletion as a status.
migration "v3" from "v2" {
    move GetItem from GET "/items/{id}"
    require ListItems.input.limit default 20
    add Kind.HUGE downgrade LARGE
    add GetItem.errors ItemGoneException downgrade ItemNotFoundException {
        message <- message
    }
    retype DeleteItem.output.deleted -> string by hook
}
