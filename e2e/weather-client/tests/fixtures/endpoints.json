{
  "smithy": "2.0",
  "shapes": {
    "example.behavior#Service": {
      "type": "service",
      "version": "1",
      "traits": {
        "crucible.protocols#json": {},
        "smithy.rules#endpointRuleSet": {
          "version": "1.0",
          "parameters": {
            "Region": {
              "type": "String",
              "builtIn": "AWS::Region",
              "required": true,
              "documentation": "Region"
            },
            "Endpoint": {
              "type": "String",
              "builtIn": "SDK::Endpoint",
              "required": true
            }
          },
          "rules": [
            {
              "conditions": [
                {
                  "fn": "stringEquals",
                  "argv": [
                    {
                      "ref": "Region"
                    },
                    "local"
                  ]
                }
              ],
              "type": "endpoint",
              "endpoint": {
                "url": "{Endpoint}/base",
                "headers": {
                  "x-region": [
                    {
                      "ref": "Region"
                    }
                  ]
                },
                "properties": {
                  "scope": {
                    "label": "{Region}"
                  },
                  "authSchemes": [
                    {
                      "name": "sigv4",
                      "signingName": "rule-service",
                      "signingRegion": "rule-region"
                    }
                  ]
                }
              }
            },
            {
              "conditions": [],
              "type": "error",
              "error": "Unknown region {Region}"
            }
          ]
        },
        "aws.auth#sigv4": {
          "name": "original"
        },
        "smithy.api#auth": [
          "aws.auth#sigv4"
        ]
      },
      "operations": [
        {
          "target": "example.behavior#Read"
        },
        {
          "target": "example.behavior#Public"
        },
        {
          "target": "example.behavior#WaitUntilReady"
        }
      ],
      "rename": {
        "example.behavior#Missing": "RenamedMissing"
      }
    },
    "example.behavior#Read": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/resource",
          "code": 200
        },
        "smithy.api#endpoint": {
          "hostPrefix": "{account}."
        },
        "smithy.waiters#waitable": {
          "Ready": {
            "minDelay": 1,
            "maxDelay": 4,
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "output": {
                    "path": "status",
                    "comparator": "stringEquals",
                    "expected": "READY"
                  }
                }
              },
              {
                "state": "retry",
                "matcher": {
                  "errorType": "example.behavior#Missing"
                }
              },
              {
                "state": "failure",
                "matcher": {
                  "success": false
                }
              }
            ]
          },
          "Gone": {
            "minDelay": 1,
            "maxDelay": 2,
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "errorType": "Missing"
                }
              }
            ]
          },
          "Exact": {
            "minDelay": 1,
            "maxDelay": 2,
            "acceptors": [
              {
                "state": "success",
                "matcher": {
                  "inputOutput": {
                    "path": "output.amount > `9007199254740992` && output.time == input.time",
                    "comparator": "booleanEquals",
                    "expected": "true"
                  }
                }
              }
            ]
          }
        },
        "smithy.api#paginated": {
          "inputToken": "nextToken",
          "outputToken": "nextToken"
        },
        "smithy.api#optionalAuth": {}
      },
      "input": {
        "target": "example.behavior#Input"
      },
      "output": {
        "target": "example.behavior#Output"
      },
      "errors": [
        {
          "target": "example.behavior#Missing"
        }
      ]
    },
    "example.behavior#Public": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/public"
        },
        "smithy.api#auth": []
      }
    },
    "example.behavior#Input": {
      "type": "structure",
      "traits": {
        "smithy.api#input": {}
      },
      "members": {
        "account": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#required": {},
            "smithy.api#hostLabel": {}
          }
        },
        "time": {
          "target": "smithy.api#Timestamp"
        },
        "nextToken": {
          "target": "smithy.api#String"
        }
      }
    },
    "example.behavior#Output": {
      "type": "structure",
      "members": {
        "status": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#jsonName": "wire-status"
          }
        },
        "time": {
          "target": "smithy.api#Timestamp",
          "traits": {
            "smithy.api#timestampFormat": "http-date"
          }
        },
        "amount": {
          "target": "smithy.api#BigDecimal"
        },
        "nextToken": {
          "target": "smithy.api#String"
        }
      }
    },
    "example.behavior#WaitUntilReady": {
      "type": "operation",
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/normal",
          "code": 204
        },
        "smithy.api#auth": []
      }
    },
    "example.behavior#Missing": {
      "type": "structure",
      "traits": {
        "smithy.api#error": "client",
        "smithy.api#httpError": 404
      },
      "members": {
        "message": {
          "target": "smithy.api#String"
        }
      }
    }
  }
}
