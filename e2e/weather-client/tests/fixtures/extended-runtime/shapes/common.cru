union Choice {
    numbers: Numbers
    dates: DateMap
}

map DateMap: string -> Dates

sparse list Dates: EpochTime

list Decimals: bigDecimal { unique }

list Documents: document { unique }

list Integers: bigInteger { unique }

enum Mode: integer {
    OFF = -1
    ON = 2147483647
}

list Names: string { unique }

list Numbers: bigDecimal { unique }

sparse map SparseMap: string -> Mode

sparse list SparseNames: string

timestamp EpochTime { format epoch-seconds }
